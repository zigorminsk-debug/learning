<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BusinessTextbook" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSurface">@color/page_bg</item>
        <item name="colorOnSurface">@color/page_text</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <!-- Статус-бар всегда тёмно-синий → иконки должны быть светлыми в обеих темах -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/page_bg</item>
    </style>

    <!-- Заголовок тулбара: одна строка с многоточием (длинные названия глав) -->
    <style name="ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
